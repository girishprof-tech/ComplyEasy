# Copy this file to .env (repo root) and fill in your own values.
# .env is gitignored — never commit real API keys. Real environment
# variables take precedence over this file.

# --- Gemini (Ask Venture, certificate analysis, search-grounded scheme discovery) ---
# Leave GEMINI_API_KEY empty to run in Demo AI Mode: every AI-labelled feature
# still works, using deterministic mock/fallback behaviour instead of a model call.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# --- Server ---
# Optional. Defaults to 8787.
PORT=8787

# Optional. Secret used to sign session cookies. If empty, a random one is
# generated at startup (everyone is logged out whenever the server restarts).
SESSION_SECRET=

# Optional. Where the SQLite database and uploaded certificates live
# (relative to the backend/ folder). Defaults to ./data
# VENTURE_DATA_DIR=./data
